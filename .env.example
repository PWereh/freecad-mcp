# freecad-mcp v0.2.0 - environment template. PLACEHOLDERS ONLY: copy to .env (or
# set these in your MCP client's registration block) and fill in real values
# there. Never commit a filled-in copy.
#
# THERE ARE NO SECRETS IN THIS SERVER. No tool takes a token, an API key, a
# licence value or a credential. The only authentication in the whole stack is
# the addon's loopback host filter (rpc_server/ip_filter.py, default 127.0.0.1).
# Everything below is a host, a port or a path.
#
# Precedence: CLI FLAG > ENVIRONMENT VARIABLE > DEFAULT.

# ---------------------------------------------------------------------------
# CLIENT side - read by freecad-mcp.exe (the MCP server process)
# ---------------------------------------------------------------------------

# XML-RPC host of the FreeCAD addon. --host wins over this. Loopback in
# practice: the MCP server must run on the same machine as the FreeCAD GUI it
# drives, and execute_code_headless spawns freecadcmd on THIS machine.
FREECAD_MCP_HOST=localhost

# XML-RPC port of the FreeCAD addon. Environment only - there is no --port flag.
FREECAD_MCP_PORT=9875

# Command that starts headless FreeCAD for execute_code_headless.
# --freecadcmd wins over this. QUOTE THE PATH if it contains spaces.
# Windows example:  "C:\Program Files\FreeCAD 1.1\bin\freecadcmd.exe"
# Flatpak example:  flatpak run --command=freecadcmd org.freecad.FreeCAD
# Leave unset to auto-detect PATH, then Flatpak.
FREECAD_MCP_FREECADCMD=<ABSOLUTE PATH TO freecadcmd, QUOTED IF IT HAS SPACES>

# Set to 1 to suppress screenshots in every tool response.
# --only-text-feedback wins over this.
FREECAD_MCP_ONLY_TEXT_FEEDBACK=0

# Logger level: DEBUG | INFO | WARNING | ERROR.
FREECAD_MCP_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# ADDON side - read INSIDE THE FREECAD PROCESS, not the client's
# ---------------------------------------------------------------------------
# Setting these for freecad-mcp.exe does NOT reach the addon. Set them for the
# FreeCAD process itself, or put "jobs_dir" / "output_cap" into
# %APPDATA%\FreeCAD\v1-1\freecad_mcp_settings.json. Resolution order addon-side
# is env -> that settings file -> the default. get_rpc_status echoes the
# EFFECTIVE jobs_dir, so the client reads receipts from a reported path and
# never guesses one.

# Where async job receipts (<job_id>.json) are written on every state change.
# Default: %LOCALAPPDATA%\freecad-mcp\jobs
FREECAD_MCP_JOBS_DIR=<ABSOLUTE PATH TO A WRITABLE DIRECTORY>

# emit() buffer cap in bytes; overflow sets output_truncated on the job record.
# Default: 1048576 (1 MiB)
FREECAD_MCP_OUTPUT_CAP=1048576

# ---------------------------------------------------------------------------
# TEST side
# ---------------------------------------------------------------------------
# Set to 1 to run the @live tests in tests/test_bridge_contract.py. They
# DISPATCH REAL WORK to a running FreeCAD GUI. Leave unset unless you own that
# GUI for the duration.
FREECAD_MCP_LIVE=0
